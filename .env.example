# RPC Endpoint for Sepolia Testnet
# You can use a public node or a provider like Alchemy/Infura
SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com

# List of wallet private keys (comma-separated, no spaces)
# Format: 0x followed by 64 hex characters
# The examples below are dummy keys, REPLACE with your actual private keys
PRIVATE_KEYS=0x0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef,0xfedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210

# List of target token contract addresses (comma-separated)
# Example: DAI and a custom token on Sepolia
# REPLACE with the addresses of tokens you want to swap
TARGET_TOKENS=0xd67215fd6c0890493f34af3c5e4231ce98871fcb,0xYourTokenAddressHere
